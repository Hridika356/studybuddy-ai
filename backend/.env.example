# Copy to backend/.env and fill in. Never commit .env.

# Required for /ask and /quiz. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model (low-cost default). Any current model that supports PDF input + citations works.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=2
ANSWER_MAX_TOKENS=2048
QUIZ_MAX_TOKENS=4096

# Upload limits
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=100
MAX_QUESTION_LENGTH=1000

# Comma-separated list of frontend origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Per-IP limit on AI requests (/ask + /quiz) within the window. 0 disables.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Storage locations (relative paths resolve from backend/)
UPLOAD_DIR=uploads
DATABASE_PATH=data/studybuddy.db

LOG_LEVEL=INFO
