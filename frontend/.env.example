# Copy to frontend/.env.local for local development.
# Every VITE_* value is bundled into public JavaScript: never put secrets here.

# URL of the FastAPI backend (no trailing slash). In production, your Render URL.
VITE_API_BASE_URL=http://localhost:8000

# Optional: keep in sync with the backend's limits (used for instant client-side feedback).
VITE_MAX_PDF_SIZE_MB=10
VITE_MAX_QUESTION_LENGTH=1000
